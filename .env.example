# PostgreSQL — lokalnie lub connection string z Supabase (Project Settings → Database → Connection string)
DATABASE_URL=postgres://portfel:portfel@localhost:5432/portfelpro

# Publiczny adres aplikacji (używany w linkach polecających)
APP_URL=http://localhost:3000

# Sekret do haszowania adresów IP / e-maili (min. 32 losowe znaki). Wygeneruj: openssl rand -hex 32
APP_SECRET=change-me-openssl-rand-hex-32

# Sekret webhooka dla zewnętrznych CRM / formularzy (nagłówek Authorization: Bearer ...)
WEBHOOK_SECRET=change-me-webhook-secret

# Tryb demo: "true" pokazuje stawki oznaczone jako DEMO. W produkcji ustaw "false" —
# stawki demo są wtedy prezentowane jako "Stawka do ustalenia".
DEMO_MODE=true
# Rejestracja/logowanie numerem telefonu — SMS-y wysyła SMSAPI.pl (token OAuth z panelu SMSAPI → Ustawienia API).
# Bez tokenu: przy DEMO_MODE=true kod pokazuje się na ekranie, przy false wejście telefonem jest wyłączone.
# SMSAPI_TOKEN=
# SMSAPI_SENDER=   # opcjonalnie: zarejestrowane pole nadawcy, np. Portfel.pro

# Konto administratora tworzone przez `npm run db:seed`
ADMIN_EMAIL=admin@portfel.pro
ADMIN_PASSWORD=change-me-strong-password

# Opcjonalnie: Google Places API (New) — pobieranie oceny i liczby opinii spółek w /admin/spolki
GOOGLE_MAPS_API_KEY=
